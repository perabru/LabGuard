[Unit]
Description=LabGuard - atualizar bloqueios conforme DHCP e vizinhos
Requires=labguard-firewall.service
After=labguard-firewall.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/labguard/agent.py --config /etc/labguard/config.json --reconcile
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/labguard /var/lib/labguard /var/log/labguard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
